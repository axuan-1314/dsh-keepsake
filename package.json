{
  "name": "dsh-keepsake",
  "version": "0.7.1",
  "private": true,
  "description": "项目记忆自动提取+注入（cordis 插件）：会话轮结束触发单次 LLM 提取，落盘 ~/.dsh/memory/projects/<slug>-<hash16>/memory/（.md+MEMORY.md 索引），经 durable 用户消息通道注入人设/索引/运行时记忆层（injectChannel 可回退到 systemPrompt 注入）。运行时记忆层把条目编译成定长 USER.md/MEMORY.md 随每轮注入，默认关。v1 单次调用简化提取。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "web/",
    "docs/",
    "cordis.patch.yml",
    "FORMAT.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node -e \"const{readdirSync}=require('node:fs');const{execFileSync}=require('node:child_process');for(const f of readdirSync('lib'))if(f.endsWith('.js'))execFileSync(process.execPath,['--check','lib/'+f],{stdio:'inherit'})\""
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "memory"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axuan-1314/dsh-keepsake.git"
  },
  "homepage": "https://github.com/axuan-1314/dsh-keepsake#readme",
  "bugs": {
    "url": "https://github.com/axuan-1314/dsh-keepsake/issues"
  },
  "author": "axuan-1314",
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2"
  },
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
